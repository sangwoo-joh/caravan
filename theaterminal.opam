opam-version: "2.0"
synopsis: "A TEA-based TUI framework built on troupe"
description:
  "Theaterminal is a TUI framework following The Elm Architecture (model/update/view), driven by the troupe actor runtime."
maintainer: ["Sangwoo Joh <work.sangwoo.joh@gmail.com>"]
authors: ["Sangwoo Joh <work.sangwoo.joh@gmail.com>"]
license: "MIT"
homepage: "https://github.com/sangwoo-joh/caravan"
bug-reports: "https://github.com/sangwoo-joh/caravan/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.19"}
  "troupe"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/sangwoo-joh/caravan.git"
x-maintenance-intent: ["(latest)"]
